{
  "name": "sightpool",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "e2e": "playwright test",
    "images": "python3 scripts/make-images.py",
    "brand:check": "node scripts/brand-check.mjs",
    "copy:check": "node scripts/copy-check.mjs",
    "placeholders:list": "node scripts/placeholders-list.mjs",
    "links:check": "node scripts/links-check.mjs",
    "nowrite:check": "node scripts/nowrite-check.mjs",
    "contrast:check": "node scripts/contrast-check.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm brand:check && pnpm copy:check && pnpm nowrite:check && pnpm contrast:check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.108.2",
    "geist": "1.9.2",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.2",
    "react-dom": "19.2",
    "viem": "2.58.4",
    "wagmi": "2.19.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "postcss": "^8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "5"
  }
