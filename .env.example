# Copy to .env.local for local builds. Never commit real values.
# Public values (inlined at build time)
NEXT_PUBLIC_MODE=mock                      # mock | readonly. Anything else falls back to mock.
NEXT_PUBLIC_AUDIT_CLEARED=false            # stays false in this phase
NEXT_PUBLIC_LEGAL_OPINION_CLEARED=false    # stays false in this phase
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=      # free Reown/WalletConnect project id (32 hex)
NEXT_PUBLIC_SITE_URL=                      # https://your-domain
NEXT_PUBLIC_TOS_VERSION=                   # e.g. 2026-11-22-draft
NEXT_PUBLIC_AUDIT_REPORT_URL=              # interface audit report (https)
NEXT_PUBLIC_POOL_AUDIT_REPORT_URL=         # underlying pool audit report (https)
NEXT_PUBLIC_INTERFACE_FEE_BPS=0
NEXT_PUBLIC_SCREENING_PROVIDER=            # no real adapter exists in this phase
NEXT_PUBLIC_SHIELDED_ADDRESS_FORMAT=
NEXT_PUBLIC_ENABLE_ETH_POOL=false
NEXT_PUBLIC_ENABLE_OXBOW=false
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_URL=

# Server values: set in Cloudflare Pages > Settings > Environment variables (never in the client bundle)
RPC_UPSTREAM_URL=                          # private RPC for chain 4663 (may contain a key)
ALLOW_PUBLIC_UPSTREAM=                     # "1" to use the official public RPC (rate-limited) when no private one is set
ALLOWED_ORIGINS=                           # extra origins for /api/rpc, comma-separated
RATE_LIMIT_PER_MINUTE=60
RESTRICTED_REGION_LIST=                    # ISO codes, comma-separated. US is always blocked.
